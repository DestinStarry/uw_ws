<mujoco model="auv-v3 scene">
  <include file="auv-v3.xml"/>

  <!-- 淡水环境：密度 1000 kg/m³，20°C 动力黏度约 0.001 Pa·s。 -->
  <option density="1000" viscosity="0.001"/>

  <statistic center="0 0 0" extent="1.0" meansize="0.1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.1 0.2 0.35 1"/>
    <global azimuth="-30" elevation="-30" ellipsoidinertia="true"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.2 0.4 0.6" rgb2="0.0 0.05 0.15" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.3 0.4 0.5" rgb2="0.15 0.25 0.35"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>
</mujoco>
